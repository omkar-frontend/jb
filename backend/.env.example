PORT=5001

# Exact frontend origin(s), no trailing slash. Comma-separate for several.
# REQUIRED when NODE_ENV=production — the server refuses to start without it.
FRONTEND_URL=http://localhost:5173

# Optional regex for preview deployments, e.g. Vercel branch URLs:
# FRONTEND_ORIGIN_REGEX=^https://jb-[a-z0-9-]+\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# Supabase — anon key + RLS, user JWT is forwarded per request
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Gemini (CV extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Job providers
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERP_API_KEY=
JSEARCH_API_KEY=

# Set to 1 on hosts that put the app behind a proxy (Render, Railway, Fly, nginx).
# Leave unset locally. Rate limiting keys on the client IP, which is wrong without this.
TRUST_PROXY=
